# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- Intervals.icu (the default source) ---------------------------------
# Both values are on https://intervals.icu/settings. The API key is used as
# an HTTP basic password, with the literal username API_KEY.
INTERVALS_ATHLETE_ID=i00000
INTERVALS_API_KEY=replace-with-your-intervals-api-key

# --- Strava (optional, secondary) ---------------------------------------
# Strava now requires a paid subscription for the endpoints longrun uses, so
# this is no longer the primary path. Only needed for `longrun ingest strava`.
# Register an application at https://www.strava.com/settings/api.
STRAVA_CLIENT_ID=00000
STRAVA_CLIENT_SECRET=replace-with-your-strava-client-secret

# Must exactly match the "Authorization Callback Domain" of your Strava app.
# For the default local flow, set that domain to `localhost`.
STRAVA_REDIRECT_URI=http://localhost/exchange_token

# --- Optional -----------------------------------------------------------
# Seed a refresh token directly instead of running `longrun auth strava`.
# STRAVA_REFRESH_TOKEN=replace-with-your-strava-refresh-token

# --- Local paths (all default to ./data, which is gitignored) -----------
# LONGRUN_DB_PATH=data/longrun.db
# LONGRUN_TOKEN_PATH=data/strava_tokens.json
# LONGRUN_REPORT_PATH=data/report.html
# Folder scanned by `longrun ingest fit` for .fit exports.
# LONGRUN_RAW_DIR=data/raw

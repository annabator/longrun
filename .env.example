# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
# Register a Strava API application at https://www.strava.com/settings/api
# to obtain the client ID and secret. See README.md > Setup.

# --- Strava API application credentials ---------------------------------
STRAVA_CLIENT_ID=00000
STRAVA_CLIENT_SECRET=replace-with-your-strava-client-secret

# Must exactly match the "Authorization Callback Domain" of your Strava app.
# For the default local flow, set that domain to `localhost`.
STRAVA_REDIRECT_URI=http://localhost/exchange_token

# --- Optional -----------------------------------------------------------
# Seed a refresh token directly instead of running `longrun auth strava`.
# STRAVA_REFRESH_TOKEN=replace-with-your-strava-refresh-token

# --- Local paths (all default to ./data, which is gitignored) -----------
# LONGRUN_DB_PATH=data/longrun.db
# LONGRUN_TOKEN_PATH=data/strava_tokens.json
# LONGRUN_REPORT_PATH=data/report.html
